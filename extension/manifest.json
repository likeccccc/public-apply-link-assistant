{
  "manifest_version": 3,
  "name": "公开投递链接助手",
  "description": "网页浮卡一键搜索；点击扩展图标打开可保持显示的设置小窗口。",
  "version": "1.7.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "permissions",
    "windows"
  ],
  "host_permissions": [
    "https://givemeoc.com/*",
    "https://www.givemeoc.com/*",
    "https://maas.qianwenaiapi.com/*",
    "https://api.openai.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开或关闭投递链接助手设置"
  },
  "content_scripts": [{
    "matches": ["https://givemeoc.com/*", "https://www.givemeoc.com/*"],
    "js": ["widget.js"],
    "run_at": "document_idle"
  }]
}
